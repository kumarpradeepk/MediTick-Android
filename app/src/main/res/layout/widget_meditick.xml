<?xml version="1.0" encoding="utf-8"?>
<!--
    Every value below except the header is replaced at runtime by
    MediTickWidgetProvider, so those use tools:text — a design-time preview that
    is stripped from the build and can never ship as untranslated English.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:gravity="center_vertical"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_header" android:textColor="#7DF0B4" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView android:id="@+id/widget_progress_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            tools:text="100%" android:textColor="#F1F7F2" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp"
        android:progressTint="#5FE4AE" android:progressBackgroundTint="#263B32" />
    <TextView android:id="@+id/widget_summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" tools:text="0 of 0 doses ticked" android:textColor="#A9BCB1" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="13dp" android:layout_marginBottom="11dp" android:background="#24382F" />
    <TextView android:id="@+id/widget_next_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        tools:text="No doses today" android:textColor="#F1F7F2" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_next_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" tools:text="You’re all caught up" android:textColor="#7DF0B4" android:textSize="12sp" />
</LinearLayout>
