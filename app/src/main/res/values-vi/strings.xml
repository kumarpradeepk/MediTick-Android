    <string name="release_lead">Bản cập nhật này đưa MediTick lên cùng một bộ tính năng trên iPhone và Android:</string>
    <string name="release_bullet_filters">Điều trị nay lọc được theo loại và theo Đang dùng, Đã xong hoặc Lưu trữ.</string>
    <string name="release_bullet_prescriptions">Đơn thuốc lưu bác sĩ kê đơn, phòng khám, liên hệ, chẩn đoán và thời gian điều trị, đồng thời có thể đánh dấu đã xong, lưu trữ hoặc khôi phục.</string>
    <string name="release_bullet_per_dose">Mỗi liều có thể có số lượng riêng và quan hệ riêng với bữa ăn, nên một loại thuốc vừa cố định lúc 08:00 vừa uống trước bữa tối 30 phút.</string>
    <string name="release_bullet_shapes">Thêm các kiểu lịch mới: mỗi N ngày và chu kỳ uống/nghỉ, bên cạnh ngày cụ thể và uống khi cần.</string>
    <string name="release_bullet_take_all">“Ghi tất cả” xử lý trọn một nhóm giờ chỉ với một chạm.</string>
    <string name="release_bullet_progress">Tiến trình có thêm lịch toàn bộ với chuyển tháng, cùng phần giải thích về tuân thủ, đúng giờ và chuỗi ngày.</string>
    <string name="release_bullet_sounds">Âm thanh nhắc, thông báo riêng tư giữ tên thuốc khỏi màn hình khoá, và bộ chọn ngôn ngữ ngay trong ứng dụng.</string>
    <string name="release_bullet_refills">Khi bổ sung, bạn xem trước lượng thuốc sau khi thêm, và giờ đã ghi có thể sửa lại sau.</string>

