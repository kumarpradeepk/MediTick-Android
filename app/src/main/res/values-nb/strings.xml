    <string name="release_bullet_progress">Fremgang får en kalender over alle dager med månedsnavigasjon, pluss forklaringer på etterlevelse, presisjon og rekker.</string>
    <string name="release_bullet_sounds">Påminnelseslyder, private varsler som holder medisinnavn borte fra låseskjermen, og en språkvelger i appen.</string>
    <string name="release_bullet_refills">Påfyll viser den nye beholdningen før du bekrefter, og registrerte tidspunkter kan rettes i etterkant.</string>

